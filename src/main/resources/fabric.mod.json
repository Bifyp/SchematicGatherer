{
  "schemaVersion": 1,
  "id": "schematic-gatherer",
  "version": "${version}",
  "name": "SchematicGatherer",
  "description": "Указываешь схематику — бот сам собирает все ресурсы. #gather через Baritone или /gatherbot — отдельный фейк-игрок в стиле Carpet /player.",
  "authors": ["Bifyp"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.bifyp.schematicgatherer.SchematicGathererInit"],
    "client": [${client_entry}]
  },
  "mixins": ["schematic-gatherer.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.1",
    "java": ">=25"
  },
  "suggests": {
    "baritone": "*"
  }
}
